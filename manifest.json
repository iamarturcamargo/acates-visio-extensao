{
  "manifest_version": 3,
  "name": "Acates Visio",
  "version": "0.10.0",
  "description": "Acates Visio: leitura local dos arquivos que a equipe de migração SAJ→SEEU distribui (lotes, logs, acervo, planilhas) — quadro geral e mapa judiciário. Não acessa rede nenhuma; nunca apaga arquivos locais.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir Acates Visio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "host_permissions": [],
  "permissions": []
}
